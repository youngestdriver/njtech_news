# SMTP 邮件配置
NEWS_SENDER_EMAIL=
NEWS_SMTP_PASSWORD=
NEWS_SMTP_HOST=smtp.qq.com
NEWS_SMTP_PORT=465

# 邮件内容和收件人
NEWS_SENDER_NAME=NJTech News
NEWS_MAIL_SUBJECT=今日公告汇总
NEWS_RECEIVERS=user@example.com

# 爬取配置
NEWS_SOURCE_URL=https://example.com/news
NEWS_CRAWL_INTERVAL=3600

# 数据库
NEWS_DATABASE_URL=sqlite+aiosqlite:////data/njtech.db

# 应用
NEWS_BASE_URL=http://localhost:8000
